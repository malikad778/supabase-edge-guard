{
  "name": "supabase-edge-guard",
  "version": "0.2.0",
  "description": "Cross-boundary static analyzer for Next.js, TanStack Start, Lovable and Supabase apps. Catches getSession() spoofing, service_role bypasses, exposed SECURITY DEFINER RPCs and RLS mistakes before deploy.",
  "type": "module",
  "bin": {
    "supabase-edge-guard": "bin/supabase-edge-guard.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen-docs": "tsx scripts/gen-docs.ts",
    "new-rule": "tsx scripts/new-rule.ts",
    "bench": "tsx scripts/bench.ts",
    "prepublishOnly": "pnpm build && pnpm test && pnpm gen-docs"
  },
  "keywords": [
    "supabase",
    "nextjs",
    "lovable",
    "rls",
    "security",
    "static-analysis",
    "sarif",
    "tanstack-start",
    "row-level-security",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malikad778/supabase-edge-guard.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^13.1.0",
    "diff": "^8.0.4",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "ts-morph": "^28.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7",
    "zod-to-json-schema": "^3.25.2"
  }
}
